{
  "name": "teams-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Cloud Run service that drives a headless Teams login and sends chat messages via Microsoft Graph.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.14.0",
    "express": "^4.21.2",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.23.4 <23"
  }
}
